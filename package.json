{
  "name": "sonicpages",
  "version": "2.0.0",
  "private": true,
  "description": "A private, accessible document reading and listening workspace.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "worker:ingestion": "tsx scripts/ingestion-worker.ts",
    "worker:audio": "tsx scripts/audio-worker.ts",
    "pwa:check": "node --check public/sw.js && node scripts/check-pwa.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "check": "npm run db:validate && npm run pwa:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.9"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-presigned-post": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@better-auth/prisma-adapter": "^1.7.5",
    "@prisma/client": "^6.12.0",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "html-to-text": "^10.0.1",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.12.3",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.28.1",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.23.13",
    "unzipper": "^0.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/unzipper": "^0.10.11",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^27.0.0",
    "jszip": "^3.10.2",
    "pdfkit": "^0.20.2",
    "prisma": "^6.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
