# PostgreSQL connection string. Use a separate direct URL later if your provider
# requires one for migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sonicpages

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (configure both or neither).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Passwordless email through Resend (configure both or neither).
RESEND_API_KEY=
EMAIL_FROM=hello@example.com

# Private S3 or S3-compatible object storage.
S3_BUCKET=sonicpages-private
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for providers such as Cloudflare R2, MinIO, or Backblaze B2.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Upload limits in bytes (defaults: 50 MiB per file, 500 MiB per user).
MAX_DOCUMENT_BYTES=52428800
USER_STORAGE_QUOTA_BYTES=524288000

# Dedicated ingestion worker polling interval.
INGESTION_POLL_INTERVAL_MS=2000

# Speech generation (private audio is written to the configured S3 bucket).
TTS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
AUDIO_POLL_INTERVAL_MS=2000
AUDIO_MAX_CHARACTERS_PER_JOB=500000
AUDIO_DAILY_CHARACTER_LIMIT=1000000
AUDIO_MAX_ACTIVE_JOBS=2
# Cost estimate only, expressed as micro-dollars per million input characters.
AUDIO_COST_PER_MILLION_CHARACTERS_MICROS=15000000
