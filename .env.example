# PostgreSQL connection string. Use a separate direct URL later if your provider
# requires one for migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sonicpages

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (configure both or neither).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Passwordless email through Resend (configure both or neither).
RESEND_API_KEY=
EMAIL_FROM=hello@example.com

# Private S3 or S3-compatible object storage.
S3_BUCKET=sonicpages-private
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for providers such as Cloudflare R2, MinIO, or Backblaze B2.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Upload limits in bytes (defaults: 50 MiB per file, 500 MiB per user).
MAX_DOCUMENT_BYTES=52428800
USER_STORAGE_QUOTA_BYTES=524288000
